# Groq API keys — entity extraction rotates through all keys present
# At minimum GROQ_API_KEY_1 is required (agent uses only key 1)
GROQ_API_KEY_1=gsk_...
GROQ_API_KEY_2=gsk_...
GROQ_API_KEY_3=gsk_...

# Neo4j AuraDB
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=

# Tavily (web search fallback)
TAVILY_API_KEY=tvly-...
